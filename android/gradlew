##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell such as ksh or
#       bash, then you need to set the SHELL environment variable to point to
#       that shell before running this script, e.g.:
#           SHELL=/usr/bin/ksh ./gradlew
#
#   (2) The script will attempt to find a gradle.properties file in the
#       project root. You can also set the GRADLE_PROPERTIES environment
#       variable to point to the file.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; empty if no leading path
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

# This is normally unused
# shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        # In POSIX sh, ulimit -H is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC3045
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
    esac
    case $MAX_FD in  #(
      '' | soft) :;; #(
      *)
        # In POSIX sh, ulimit -n is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC3045
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

# Collect all arguments for the java command, stacking in reverse order:
#   * args from the command line
#   * the main class name
#   * -classpath
#   * -D...appname settings
#   * --module-path (only if needed)
#   * DEFAULT_JVM_OPTS, JAVA_OPTS, and GRADLE_OPTS environment variables.

# For Cygwin or MSYS, switch paths to Windows format before running java
if "$cygwin" || "$msys" ; then
    APP_HOME=$( cygpath --path --mixed "$APP_HOME" )
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH" )

    JAVACMD=$( cygpath --unix "$JAVACMD" )

    # Now convert the arguments - sloppy, but they'd need to be *four* quoted.
    # - The 'exec' command below will use the shell's path resolution to find java.
    #   However, we need to use cygpath to convert the paths beforehand.
    #   Also quotes need to be escaped. The pattern is:
    #   "arg1" ... -> "arg1" ...
    #
    # To be safe, we just use the default conversion (without escaping) and hope
    # nothing uses spaces or other special characters.
    for arg do
        if [ -n "$(printf %s "$arg" | tr -d '[:print:]')" ]; then
            # If the argument contains non-printable characters, it's probably a file path.
            # In Cygwin/MSYS, we need to convert it to a Windows path.
            arg=$( cygpath --path --mixed "$arg" )
        fi
        # Shell will correctly handle the quoting
    done
fi

# Collect the arguments for the Java command.
# * The main class is the last argument.
# * The -classpath is the second last argument (if there is one).
# * The -D... arguments are all the arguments except the two last ones (if they exist).
# * Then there are the --module-path arguments (if any) before that.
# * And then the rest of the arguments.

# The following is technically not POSIX-compliant, but the parsing can be
# rewritten to be POSIX-compliant if necessary.
# The current implementation uses shell parameter expansion to extract the last
# arguments. It also uses the `set --` builtin to split the arguments into
# positional parameters.

# The Java main class is the last argument.
# The -classpath is the second last argument (if there is one).
# The -D... arguments are all the arguments except the two last ones (if they exist).
# Then there are the --module-path arguments (if any) before that.
# And then the rest of the arguments.

# Java main class: the last argument.
# Java -classpath: the second last argument (if there is one).

# We use `set --` to split the arguments into positional parameters.

set -- "$@" --classpath "$CLASSPATH"

# Remove the --classpath argument (it's now part of the positional parameters).
# We also remove the main class argument (it's the last one).
while [ $# -gt 1 ]; do
    # Remove the first argument
    shift
done

# Remove the main class argument.
shift

# The final positional parameter is the classpath.
CLASSPATH="$1"

# JAVA_OPTS and GRADLE_OPTS are environment variables.
JAVA_OPTS=${JAVA_OPTS:-}
GRADLE_OPTS=${GRADLE_OPTS:-}
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Split the arguments into those that are for the JVM and those that are for Gradle.
JVM_ARGS=""
GRADLE_ARGS=""
while [ $# -gt 0 ]; do
    case "$1" in
        -D* | --module-path*)
            JVM_ARGS="$JVM_ARGS $1"
            ;;
        *)
            GRADLE_ARGS="$GRADLE_ARGS $1"
            ;;
    esac
    shift
done

# If Gradle args are empty, use the default args (from GRADLE_OPTS and JAVA_OPTS).
if [ -z "$GRADLE_ARGS" ]; then
    GRADLE_ARGS="$GRADLE_OPTS $JAVA_OPTS $DEFAULT_JVM_OPTS"
fi

# Execute Gradle
exec "$JAVACMD" $JVM_ARGS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain $GRADLE_ARGS
